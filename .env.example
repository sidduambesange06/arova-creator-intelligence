# Arova Creator Intelligence — Environment Configuration
APP_NAME="Arova Creator Intelligence"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# API & CORS
API_HOST="127.0.0.1"
API_PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Local Storage Paths
DATA_DIR="./data"
SQLITE_DB_PATH="./data/app.db"
VECTOR_STORAGE_DIR="./data/vectors"
# Legacy alias for backward compatibility:
# CHROMA_PERSIST_DIR="./data/vectors"
MEDIA_STORAGE_DIR="./data/media"
ALLOWED_MEDIA_ROOTS="./data/media"

# Local AI Models (Optional dependencies: install via uv pip install -e ".[ai,asr]")
WHISPER_MODEL_SIZE="base"
WHISPER_COMPUTE_TYPE="int8"
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
RERANKER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"

# Optional Cloud Providers (Zero remote egress by default; requires explicit consent)
GEMINI_API_KEY=""
AI_REMOTE_CONSENT=false
