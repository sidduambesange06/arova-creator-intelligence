{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arova.ai/schemas/indic_creator_bench/provenance_v1.schema.json",
  "title": "Arova Indic Creator Bench ASR & Batch Provenance v1.0.0",
  "oneOf": [
    { "$ref": "#/$defs/ASRRunProvenance" },
    { "$ref": "#/$defs/BatchRunProvenance" }
  ],
  "$defs": {
    "ASRRunProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_schema_version",
        "run_id",
        "created_at_utc",
        "dataset_id",
        "dataset_version",
        "split",
        "manifest_sha256",
        "provider_type",
        "model_id",
        "model_revision",
        "device",
        "compute_type",
        "language_mode",
        "normalization_policy_version",
        "decoding_params",
        "config_fingerprint_sha256",
        "execution_status",
        "environment",
        "secret_safe_verified"
      ],
      "properties": {
        "provenance_schema_version": { "type": "string", "const": "1.0.0" },
        "run_id": { "type": "string", "minLength": 1 },
        "created_at_utc": { "type": "string", "minLength": 10 },
        "dataset_id": { "type": "string", "minLength": 1 },
        "dataset_version": { "type": "string", "minLength": 1 },
        "split": { "type": "string", "minLength": 1 },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "provider_type": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "model_revision": { "type": "string", "minLength": 1 },
        "device": { "type": "string", "minLength": 1 },
        "compute_type": { "type": "string", "minLength": 1 },
        "language_mode": { "type": "string", "enum": ["forced", "auto", "mixed"] },
        "normalization_policy_version": { "type": "string", "minLength": 1 },
        "decoding_params": { "type": "object" },
        "config_fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "execution_status": { "type": "string", "enum": ["NOT_RUN", "COMPLETED", "PARTIAL", "FAILED"] },
        "environment": { "type": "object" },
        "secret_safe_verified": { "type": "boolean", "const": true }
      }
    },
    "BatchRunProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_schema_version",
        "batch_id",
        "created_at_utc",
        "dataset_id",
        "dataset_version",
        "split",
        "manifest_sha256",
        "total_items",
        "processed_items",
        "succeeded_items",
        "failed_items",
        "skipped_items",
        "run_ids",
        "config_fingerprint_sha256",
        "execution_status",
        "secret_safe_verified"
      ],
      "properties": {
        "batch_schema_version": { "type": "string", "const": "1.0.0" },
        "batch_id": { "type": "string", "minLength": 1 },
        "created_at_utc": { "type": "string", "minLength": 10 },
        "dataset_id": { "type": "string", "minLength": 1 },
        "dataset_version": { "type": "string", "minLength": 1 },
        "split": { "type": "string", "minLength": 1 },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "total_items": { "type": "integer", "minimum": 0 },
        "processed_items": { "type": "integer", "minimum": 0 },
        "succeeded_items": { "type": "integer", "minimum": 0 },
        "failed_items": { "type": "integer", "minimum": 0 },
        "skipped_items": { "type": "integer", "minimum": 0 },
        "run_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "config_fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "execution_status": { "type": "string", "enum": ["NOT_RUN", "COMPLETED", "PARTIAL", "FAILED"] },
        "secret_safe_verified": { "type": "boolean", "const": true },
        "notes": { "type": "string" }
      }
    }
  }
}
